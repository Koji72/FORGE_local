# =============================================================================
# Forge Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# All settings have sensible defaults and are optional.

# =============================================================================
# LLM Configuration (Ollama)
# =============================================================================

# Ollama API endpoint
FORGE_OLLAMA_URL=http://127.0.0.1:11434

# Model for chat/reasoning
FORGE_OLLAMA_CHAT_MODEL=llama3

# Model for embeddings
FORGE_OLLAMA_EMBED_MODEL=nomic-embed-text

# =============================================================================
# Database
# =============================================================================

# Path to vault database (default: platform-specific app data dir)
# FORGE_VAULT_PATH=/path/to/forge.db

# Enable verbose SQL logging (development only)
FORGE_SQL_LOG=false

# =============================================================================
# Development
# =============================================================================

# Log level: error, warn, info, debug, trace
RUST_LOG=forge=info

# Enable Tauri devtools in release builds
FORGE_DEVTOOLS=false

# =============================================================================
# Sync (Optional)
# =============================================================================

# Default relay server URL (user can override in settings)
# FORGE_RELAY_URL=wss://relay.example.com

# =============================================================================
# Paths
# =============================================================================

# Backup directory (default: platform-specific)
# FORGE_BACKUP_DIR=/path/to/backups

# Plugin directory (default: platform-specific)
# FORGE_PLUGIN_DIR=/path/to/plugins
